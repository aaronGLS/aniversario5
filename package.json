{
  "name": "a-cinco-pasos-de-ti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test \"test/unit/*.test.js\"",
    "check:design": "node scripts/validar-diseno.mjs",
    "check:assets": "node scripts/validar-diseno.mjs --release",
    "build:prototype": "vite build --mode prototype",
    "build:pages": "npm run check:assets && vite build",
    "build": "npm run check:assets && npm test && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "vite": "8.3.7"
  }
}
